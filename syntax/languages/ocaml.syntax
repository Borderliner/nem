# OCaml, and ocamllex and ocamlyacc sources.
#
# A capitalised name is a module or a constructor; a type is written in lower
# case. 'a is a type variable and 'a' a character.

language ocaml
files *.ml *.mli *.mll *.mly
shebang ocaml

calls none
word-chars '

# (* opens a comment, and ( * ) - with its blanks - is the operator.
comment (* *) nested
string " multiline
# A quoted string, {|...|} or {id|...|id}, which only its own id closes,
# and its extension form {%ext|...|}.
region string
    start \{(?:%%?[A-Za-z_][A-Za-z0-9_.]*\s*)?([a-z_]*)\|
    end \|\1\}
    multiline

match comment ^#!.*$
# A toplevel directive, #use "topfind";; and an ocamlyacc declaration.
match keyword ^#[a-z]+
match keyword ^%(?:[a-z]+|%|\{|\})
# An attribute or extension: [@@deriving show], [%expr ...].
match keyword \[(?:@{1,3}|%%?)[A-Za-z_][A-Za-z0-9_.]*
match string '(?:\\.[^']*|[^'\\])'
match type '[a-z_][A-Za-z0-9_']*
# A polymorphic variant.
match constant `[A-Za-z_][A-Za-z0-9_']*
# A let that takes arguments defines a function; let x = 1 does not.
match (?P<keyword>let|and)(?:\s+(?P<keyword>rec))?\s+(?P<function>[a-z_][A-Za-z0-9_']*)(?:\s*\(|\s+[a-z_~?])
match type [A-Z][A-Za-z0-9_']*

keywords and as assert asr begin class constraint do done downto else end
keywords exception external for fun function functor if in include inherit
keywords initializer land lazy let lor lsl lsr lxor match method mod module
keywords mutable new nonrec object of open or private rec sig struct then to
keywords try type val virtual when while with

types array bool bytes char exn float format int int32 int64 lazy_t list
types nativeint option result string unit

constants true false

functions decr failwith fst ignore incr invalid_arg not print_endline
functions print_int print_newline print_string prerr_endline raise ref snd

declares function external method
declares type type class
