# INI files, and the many formats written like them: systemd units, git's
# and editorconfig's settings, desktop entries.

language ini
files *.ini *.cfg *.conf *.desktop *.service *.socket *.timer *.target
files *.mount *.path *.slice *.network *.netdev *.link .gitconfig .gitmodules
files .editorconfig .npmrc .curlrc .wgetrc

calls none
operators =
punctuation none
numbers -?[0-9]+(\.[0-9]+)?

match comment ^\s*[#;].*$
match type ^\s*\[[^\]]*\]
match ^\s*(?P<function>[A-Za-z0-9_.-]+)\s*=
string "
string ' raw

constants true false yes no on off
