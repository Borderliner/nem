# Go.
#
# Every language nem colours is a file like this one, and yours can sit
# beside them in the syntax directory next to init.lua. The format is on the
# wiki's Languages page.

language go
files *.go

comment //
comment /* */
string "
string '
string ` raw multiline

keywords break case chan const continue default defer else fallthrough for
keywords func go goto if import interface map package range return select
keywords struct switch type var

# A predeclared type is a type even where it is called: string(b) is a
# conversion, not a call.
types any bool byte comparable complex64 complex128 error float32 float64
types int int8 int16 int32 int64 rune string uint uint8 uint16 uint32 uint64
types uintptr

constants true false nil iota

declares type type
