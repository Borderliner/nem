# Erlang.
#
# A name in lower case is an atom, unless it is called or names a module;
# a capitalised one is a variable, left plain. The keywords are a match
# rule, not a word list, since they must be read before any atom is.

language erlang
files *.erl *.hrl *.escript
shebang escript

word-chars @
numbers [0-9]+#[0-9A-Za-z]+|[0-9][0-9_]*(?:\.[0-9][0-9_]*(?:[eE][-+]?[0-9]+)?)?

# %% is what a programmer writes by hand, so M-; writes it.
comment %%
comment %
string " multiline
# OTP 27's triple-quoted string, which takes no escapes.
string """ raw multiline

# The #! line of an escript.
match comment ^#!.*$
# An attribute: -module(m). -export([f/1]). -define(X, 1).
match keyword ^-[a-z_][A-Za-z0-9_]*
# A character: $a, $\n, and $" standing for itself.
match constant \$(?:\\(?:x\{[0-9a-fA-F]+\}|[0-7]{1,3}|\^.|.)|.)
# A macro: ?MODULE, and ?LOG(...) called.
match (?P<function>\?\??[A-Za-z_][A-Za-z0-9_@]*)\s*\(
match constant \?\??[A-Za-z_][A-Za-z0-9_@]*
match (?P<keyword>after|and|andalso|band|begin|bnot|bor|bsl|bsr|bxor|case|catch|cond|div|else|end|fun|if|let|maybe|not|of|or|orelse|receive|rem|try|when|xor)(?:[^A-Za-z0-9_@]|$)
# A call, a function named by its arity (f/1), and a module (lists:map).
match (?P<function>[a-z][A-Za-z0-9_@]*)\s*\(
match (?P<function>[a-z][A-Za-z0-9_@]*)/[0-9]
match (?P<type>[a-z][A-Za-z0-9_@]*):[a-z']
match constant [a-z][A-Za-z0-9_@]*
match constant '(?:[^'\\]|\\.)*'
