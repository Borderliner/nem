# CSS.

language css
files *.css

word-chars -
comment /* */
string "
string '

match keyword @[a-zA-Z-]+
match constant #[0-9a-fA-F]{3,8}\b
match type [.#][A-Za-z_-][A-Za-z0-9_-]*
match type ::?[a-z-]+
match (?P<function>[a-z-]+)\s*:(?:[^:]|$)
numbers [-+]?(?:[0-9]+(?:\.[0-9]+)?|\.[0-9]+)(?:px|em|rem|ex|ch|vw|vh|vmin|vmax|%|s|ms|deg|rad|turn|fr|pt|pc|cm|mm|in|dpi|dppx|x)?

constants inherit initial unset revert none auto important
