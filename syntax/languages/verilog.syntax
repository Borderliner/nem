# Verilog and SystemVerilog.

language verilog
files *.v *.vh *.sv *.svh

comment //
comment /* */
string "

# A sized or based literal: 8'hFF, 4'b1010, 'd10, 16'sh_7fff, 4'bx01z.
match number (?:[0-9][0-9_]*[ \t]*)?'[sS]?[bBoOdDhH][ \t]*[0-9a-fA-FxXzZ?_]+
# SystemVerilog's unsized fills: '0, '1, 'x, 'z.
match number '[01xXzZ]\b
# System tasks and functions: $display, $finish, $clog2.
match function \$[A-Za-z_][A-Za-z0-9_$]*
# Compiler directives, then the uses of a `define'd macro.
match keyword `(?:define|undef|undefineall|include|ifdef|ifndef|elsif|else|endif|timescale|default_nettype|resetall|celldefine|endcelldefine|line|pragma|begin_keywords|end_keywords|unconnected_drive|nounconnected_drive)\b
match function `[A-Za-z_][A-Za-z0-9_]*

