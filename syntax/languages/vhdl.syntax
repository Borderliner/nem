# VHDL.

language vhdl
files *.vhd *.vhdl
ignore-case
# data(7 downto 0) is a slice far more often than f(x) is a call, so only
# the standard functions below are coloured as functions.
calls none

comment --
comment /* */
string " doubled

# A bit string: X"FF", B"1010", O"17", and VHDL-2008's 8UX"0F".
match number (?i)[0-9]*[us]?[bodx]"[0-9a-z_-]*"
# A tick is three things: a character literal, '1'; the start of an
# attribute, clk'event; and a qualified expression, T'(...). A name before
# '( is the type being qualified, and its tick is taken with it, so the
# character literal rule never sees '(' there. A character literal is
# tried before an attribute, which is any other tick before a name.
match (?P<type>[A-Za-z][A-Za-z0-9_]*)(?P<punctuation>')\(
match string '.'
match (?P<punctuation>')(?P<function>[A-Za-z][A-Za-z0-9_]*)

# A based literal, 16#FF# or 2#1010#, and a decimal one: 1_000, 1.0e-9.
numbers [0-9][0-9_]*#[0-9A-Fa-f_]+(?:\.[0-9A-Fa-f_]+)?#(?:[eE][-+]?[0-9][0-9_]*)?|[0-9][0-9_]*(?:\.[0-9][0-9_]*)?(?:[eE][-+]?[0-9][0-9_]*)?

keywords abs access after alias all and architecture array assert assume
keywords attribute begin block body buffer bus case component configuration
keywords constant context cover default disconnect downto else elsif end
keywords entity exit fairness file for force function generate generic group
keywords guarded if impure in inertial inout is label library linkage literal
keywords loop map mod nand new next nor not of on open or others out package
keywords parameter port postponed procedure process property protected pure
keywords range record register reject release rem report restrict return rol
keywords ror select sequence severity shared signal sla sll sra srl strong
keywords subtype then to transport type unaffected units until use variable
keywords vmode vprop vunit wait when while with xnor xor

types bit bit_vector boolean boolean_vector character integer integer_vector
types natural positive real real_vector severity_level string time
types time_vector delay_length file_open_kind file_open_status std_logic
types std_logic_vector std_ulogic std_ulogic_vector signed unsigned line text

constants true false null

functions rising_edge falling_edge to_integer to_unsigned to_signed resize
functions shift_left shift_right rotate_left rotate_right to_stdlogicvector
functions to_stdulogicvector to_bitvector to_bit to_x01 is_x to_string
functions to_hstring to_ostring conv_integer conv_std_logic_vector now
functions readline writeline read write hread hwrite oread owrite endfile
functions file_open file_close deallocate minimum maximum std_match

declares function function procedure
declares type type subtype entity architecture package component
declares type configuration context
