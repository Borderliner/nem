# Zig.

language zig
files *.zig *.zon

# //, /// and //! are all line comments; Zig has no block comment.
comment //
string "
string '
# A multiline string is a run of lines, each starting \\ and running to
# the end of its line.
match string \\\\.*

# @import, @as, @intCast: the builtins.
match function @[A-Za-z_][A-Za-z0-9_]*
# An integer of any width: u3, i7, u128.
match type [iu][0-9]+\b
# A container given a name: const Point = struct, var E = error{...}.
match (?P<keyword>const|var)\s+(?P<type>[A-Za-z_][A-Za-z0-9_]*)\s*=\s*(?:(?:(?:extern|packed)\s+)?(?:struct|enum|union|opaque)\b|error\s*\{)

keywords addrspace align allowzero and anyframe anytype asm async await break
keywords callconv catch comptime const continue defer else enum errdefer
keywords error export extern fn for if inline linksection noalias noinline
keywords nosuspend opaque or orelse packed pub resume return struct suspend
keywords switch test threadlocal try union unreachable usingnamespace var
keywords volatile while

types isize usize f16 f32 f64 f80 f128 bool void noreturn type anyerror
types anyopaque comptime_int comptime_float c_char c_short c_ushort c_int
types c_uint c_long c_ulong c_longlong c_ulonglong c_longdouble

constants true false null undefined

declares function fn
