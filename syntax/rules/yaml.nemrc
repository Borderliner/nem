# YAML.

syntax yaml "\.(yaml|yml)$"
comment "#"

# A key is the structural thing in YAML, so it gets the colour the eye tracks.
class function "^[[:blank:]]*-?[[:blank:]]*[A-Za-z_][A-Za-z0-9_.-]*(?::)"
class keyword "^[[:blank:]]*-[[:blank:]]"
class keyword "^---$|^\.\.\.$"
class constant "\b(true|false|yes|no|on|off|null|~|True|False|Null|TRUE|FALSE|NULL)\b"
class constant "[&*][A-Za-z0-9_-]+"
class number "\b-?[0-9]+(\.[0-9]+)?([eE][-+]?[0-9]+)?\b"
class type "![A-Za-z0-9_!/:.-]+"

class comment "(^|[[:blank:]])#.*$"

class string "'([^']|'')*'"
class string "\"([^\"\\]|\\.)*\""
