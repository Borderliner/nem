# JavaScript, including JSX.

syntax javascript "\.(js|mjs|cjs|jsx)$"
comment "//"

class function "\bfunction[[:blank:]]+[A-Za-z_$][A-Za-z0-9_$]*"
class type "\bclass[[:blank:]]+[A-Za-z_$][A-Za-z0-9_$]*"

class keyword "\b(async|await|break|case|catch|class|const|continue|debugger|default|delete|do|else|export|extends|finally|for|from|function|get|if|import|in|instanceof|let|new|of|return|set|static|super|switch|this|throw|try|typeof|var|void|while|with|yield)\b"
class constant "\b(true|false|null|undefined|NaN|Infinity|globalThis)\b"
class type "\b(Array|Boolean|Date|Error|Function|JSON|Map|Math|Number|Object|Promise|Proxy|RegExp|Set|String|Symbol|WeakMap|WeakSet)\b"

class number "\b0[xX][0-9a-fA-F_]+n?\b"
class number "\b0[bB][01_]+n?\b"
class number "\b[0-9][0-9_]*(\.[0-9_]*)?([eE][-+]?[0-9]+)?n?\b"

class comment "//.*$"
class comment start="/\*" end="\*/"

class string "`[^`]*`"
class string start="`" end="`"
class string "\"([^\"\\]|\\.)*\""
class string "'([^'\\]|\\.)*'"
