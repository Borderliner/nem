# TOML.

syntax toml "\.toml$" "^(Cargo\.lock|poetry\.lock)$"
comment "#"

class type "^[[:blank:]]*\[\[?[^]]*\]\]?"
class function "^[[:blank:]]*[A-Za-z0-9_.-]+[[:blank:]]*(?:=)"
class constant "\b(true|false)\b"
class number "\b[0-9]{4}-[0-9]{2}-[0-9]{2}([Tt ][0-9:.+Zz-]+)?"
class number "\b[-+]?[0-9][0-9_]*(\.[0-9_]+)?([eE][-+]?[0-9]+)?\b"
class number "\b0[xbo][0-9a-fA-F_]+\b"

class comment "#.*$"

class string "\"\"\"([^\"]|\"[^\"]|\"\"[^\"])*\"\"\""
class string start="\"\"\"" end="\"\"\""
class string "'''([^']|'[^']|''[^'])*'''"
class string start="'''" end="'''"
class string "'[^']*'"
class string "\"([^\"\\]|\\.)*\""
