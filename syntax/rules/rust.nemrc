# Rust.

syntax rust "\.rs$"
comment "//"

class function "\bfn[[:blank:]]+[A-Za-z_][A-Za-z0-9_]*"
class type "\b(struct|enum|trait|union)[[:blank:]]+[A-Za-z_][A-Za-z0-9_]*"

class keyword "\b(as|async|await|break|const|continue|crate|dyn|else|enum|extern|fn|for|if|impl|in|let|loop|match|mod|move|mut|pub|ref|return|self|Self|static|struct|super|trait|type|unsafe|use|where|while|yield)\b"
class type "\b(bool|char|f32|f64|i8|i16|i32|i64|i128|isize|str|u8|u16|u32|u64|u128|usize|String|Vec|Option|Result|Box|Rc|Arc|HashMap|HashSet)\b"
class constant "\b(true|false|None|Some|Ok|Err)\b"
class constant "'[a-z_][a-z0-9_]*\b"
class function "\b[a-z_][a-z0-9_]*!"

# The literal suffix is part of the number: without it there is no word
# boundary after the digits of 0xFF_u8 and the whole literal goes unmatched.
class number "\b0[xX][0-9a-fA-F_]+(_?[iu](8|16|32|64|128|size))?\b"
class number "\b0[bB][01_]+(_?[iu](8|16|32|64|128|size))?\b"
class number "\b0[oO][0-7_]+(_?[iu](8|16|32|64|128|size))?\b"
class number "\b[0-9][0-9_]*(\.[0-9_]+)?([eE][-+]?[0-9]+)?(_?[iuf](8|16|32|64|128|size))?\b"

class comment "//.*$"
class comment start="/\*" end="\*/"

class string "b?r#*\"[^\"]*\"#*"
class string "b?\"([^\"\\]|\\.)*\""
class string "b?'([^'\\]|\\.)'"
